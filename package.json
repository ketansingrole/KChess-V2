{
  "name": "kchess-electron",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "vue-tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "pack:mac": "npm run build && electron-builder --mac dir"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.0",
    "chess.js": "^1.4.0",
    "tailwindcss": "^4.1.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.1.0"
  },
  "build": {
    "appId": "com.kchess.electron",
    "productName": "KChess",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["out/**/*", "package.json"],
    "mac": { "target": "dir", "icon": "build/icon.icon", "identity": null }
  }
}
