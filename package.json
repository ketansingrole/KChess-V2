{
  "name": "kchess-electron",
  "version": "0.1.0",
  "description": "A desktop chess app: play Stockfish, play on Lichess, follow friends, review games.",
  "license": "GPL-3.0-or-later",
  "author": "Ketan Singrole",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ketansingrole/KChess-V2.git"
  },
  "homepage": "https://github.com/ketansingrole/KChess-V2#readme",
  "bugs": {
    "url": "https://github.com/ketansingrole/KChess-V2/issues"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "app": "npm run build && node scripts/with-branded-electron.mjs electron .",
    "build": "node scripts/build.mjs",
    "typecheck": "nuxt typecheck && tsc --noEmit -p tsconfig.electron.json && vue-tsc --noEmit -p tsconfig.tests.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:chess": "node --experimental-strip-types scripts/chess-smoke.ts",
    "test:puzzles": "node --experimental-strip-types scripts/puzzle-smoke.ts",
    "test:lifecycle": "vitest run tests/unit/lifecycle.test.ts tests/unit/online-session.test.ts",
    "test": "npm run test:smoke && npm run test:unit",
    "start": "node scripts/with-branded-electron.mjs electron .",
    "pack:mac": "npm run build && electron-builder --mac dir",
    "postinstall": "install-electron && nuxt prepare",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test:smoke": "npm run test:chess && npm run test:puzzles && node --experimental-strip-types scripts/main-smoke.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test:e2e": "node scripts/e2e.mjs",
    "test:packaged": "node scripts/e2e.mjs --packaged",
    "pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.2",
    "lru-cache": "^11.5.3",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.3",
    "stockfish": "^19.0.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@lichess-org/chessground": "^10.4.0",
    "@lichess-org/types": "^2.0.174",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/ui": "^4.11.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@unovis/ts": "^1.7.0",
    "@unovis/vue": "^1.7.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^14.4.0",
    "chessops": "^0.15.1",
    "electron": "^44.5.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.5",
    "nuxt": "^4.5.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.0",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.1.0"
  },
  "build": {
    "appId": "com.kchess.electron",
    "productName": "KChess",
    "copyright": "Copyright \u00a9 2026 Ketan Singrole. Licensed under the GPL-3.0-or-later.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      ".output/public/**/*",
      "package.json",
      "node_modules/stockfish/bin/stockfish-19-lite.js",
      "node_modules/stockfish/bin/stockfish-19-lite.wasm",
      "!node_modules/stockfish/bin/stockfish.*",
      "!node_modules/stockfish/bin/stockfish-19.*",
      "!node_modules/stockfish/bin/stockfish-19-single.*",
      "!node_modules/stockfish/bin/stockfish-19-lite-single.*",
      "!node_modules/stockfish/bin/stockfish-19-asm.js"
    ],
    "mac": {
      "target": "dir",
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "asarUnpack": [
      "node_modules/stockfish/bin/**"
    ]
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "esbuild": true,
    "stockfish": true,
    "vue-demi": true,
    "unrs-resolver": true,
    "electron-winstaller": true,
    "fsevents": true
  }
}
