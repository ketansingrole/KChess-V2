{
  "name": "kchess-electron",
  "version": "2026.10.4",
  "description": "A desktop chess app: play Stockfish, play on Lichess, follow friends, review games.",
  "license": "GPL-3.0-or-later",
  "author": "Ketan Singrole",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ketansingrole/KChess-V2.git"
  },
  "homepage": "https://github.com/ketansingrole/KChess-V2#readme",
  "bugs": {
    "url": "https://github.com/ketansingrole/KChess-V2/issues"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "app": "pnpm run build && node scripts/with-branded-electron.mjs electron .",
    "build": "node scripts/build.mjs",
    "typecheck": "nuxt typecheck && tsc --noEmit -p tsconfig.electron.json && vue-tsc --noEmit -p tsconfig.tests.json",
    "prepare:voice": "node scripts/prepare-voice-model.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:chess": "node --experimental-strip-types scripts/chess-smoke.ts",
    "test:puzzles": "node --experimental-strip-types scripts/puzzle-smoke.ts",
    "test:puzzle-worker": "node scripts/puzzle-worker-smoke.mjs",
    "benchmark:library": "node scripts/library-benchmark.mjs",
    "test:lifecycle": "vitest run tests/unit/lifecycle.test.ts tests/unit/online-session.test.ts",
    "test": "pnpm run test:smoke && pnpm run test:unit",
    "start": "node scripts/with-branded-electron.mjs electron .",
    "pack:mac": "pnpm run build && electron-builder --mac dir --arm64",
    "postinstall": "install-electron && nuxt prepare",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test:smoke": "pnpm run test:chess && pnpm run test:puzzles && node --experimental-strip-types scripts/main-smoke.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/run-checks.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:packaged": "node scripts/e2e.mjs --packaged",
    "pack": "pnpm run build && electron-builder --dir",
    "release:version": "node scripts/next-version.mjs",
    "release:verify": "node scripts/release-rules.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "check:fast": "node scripts/check-fast.mjs",
    "check:performance": "node scripts/library-benchmark.mjs --check",
    "check:report": "node scripts/guardrail-report.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fflate": "0.8.3",
    "lru-cache": "^11.5.3",
    "openapi-fetch": "^0.17.0",
    "stockfish": "^19.0.0",
    "tar": "7.5.22",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@iconify-json/lucide": "^1.2.0",
    "@lichess-org/chessground": "^10.4.1",
    "@lichess-org/types": "^2.0.175",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/ui": "^4.11.3",
    "@pinia/nuxt": "^1.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "chessops": "^0.15.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "happy-dom": "^20.14.5",
    "nuxt": "^4.6.0",
    "pinia": "^4.0.3",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "vosk-browser": "0.0.8",
    "vue": "^3.5.0",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.12",
    "yaml": "2.9.1"
  },
  "build": {
    "appId": "com.kchess.electron",
    "productName": "KChess",
    "copyright": "Copyright \u00a9 2026 Ketan Singrole. Licensed under the GPL-3.0-or-later.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      ".output/public/**/*",
      "!.output/public/voice/model.tar.gz*",
      "package.json",
      "node_modules/stockfish/bin/stockfish-19-lite.js",
      "node_modules/stockfish/bin/stockfish-19-lite.wasm",
      "!node_modules/stockfish/bin/stockfish.*",
      "!node_modules/stockfish/bin/stockfish-19.*",
      "!node_modules/stockfish/bin/stockfish-19-single.*",
      "!node_modules/stockfish/bin/stockfish-19-lite-single.*",
      "!node_modules/stockfish/bin/stockfish-19-asm.js"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "KChess uses your microphone to recognize spoken chess moves and square names on this device."
      },
      "category": "public.app-category.board-games"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "synopsis": "Desktop chess: Stockfish, Lichess, puzzles and training",
      "maintainer": "Ketan Singrole"
    },
    "asarUnpack": [
      "node_modules/stockfish/bin/**"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "ketansingrole",
      "repo": "KChess-V2",
      "releaseType": "release"
    },
    "afterPack": "scripts/after-pack.cjs"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "packageManager": "pnpm@11.19.0"
}
