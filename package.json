{
  "name": "kchess-electron",
  "version": "0.1.0",
  "description": "A desktop chess app: play Stockfish, play on Lichess, follow friends, review games.",
  "license": "GPL-3.0-or-later",
  "author": "Ketan Singrole",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ketansingrole/KChess-V2.git"
  },
  "homepage": "https://github.com/ketansingrole/KChess-V2#readme",
  "bugs": {
    "url": "https://github.com/ketansingrole/KChess-V2/issues"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/with-branded-electron.mjs concurrently -k \"nuxt dev --host 127.0.0.1 --port 3000\" \"wait-on http://127.0.0.1:3000 && KCHESS_NUXT_URL=http://127.0.0.1:3000 electron-vite dev --watch\"",
    "app": "npm run build && node scripts/with-branded-electron.mjs electron .",
    "build": "npm run typecheck && NUXT_APP_BASE_URL=./ nuxt generate && electron-vite build",
    "typecheck": "nuxt typecheck && tsc --noEmit -p tsconfig.electron.json",
    "format": "prettier --write \"app/**/*.{vue,ts}\" \"src/**/*.ts\" \"scripts/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"app/**/*.{vue,ts}\" \"src/**/*.ts\" \"scripts/**/*.{ts,mjs}\"",
    "test:chess": "node --experimental-strip-types scripts/chess-smoke.ts",
    "test": "npm run test:chess && node --experimental-strip-types scripts/main-smoke.ts",
    "start": "node scripts/with-branded-electron.mjs electron .",
    "pack:mac": "npm run build && electron-builder --mac dir"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.2",
    "lru-cache": "^11.5.3",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.3",
    "stockfish": "^19.0.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@lichess-org/chessground": "^10.4.0",
    "@lichess-org/types": "^2.0.174",
    "@nuxt/ui": "^4.11.0",
    "@types/node": "^26.6.3",
    "@unovis/ts": "^1.7.0",
    "@unovis/vue": "^1.7.0",
    "@vueuse/core": "^14.4.0",
    "chessops": "^0.15.1",
    "concurrently": "^10.0.5",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "nuxt": "^4.5.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.1.0",
    "wait-on": "^9.4.0"
  },
  "build": {
    "appId": "com.kchess.electron",
    "productName": "KChess",
    "copyright": "Copyright © 2026 Ketan Singrole. Licensed under the GPL-3.0-or-later.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      ".output/public/**/*",
      "package.json",
      "node_modules/stockfish/bin/stockfish-19-lite.js",
      "node_modules/stockfish/bin/stockfish-19-lite.wasm",
      "!node_modules/stockfish/bin/stockfish.*",
      "!node_modules/stockfish/bin/stockfish-19.*",
      "!node_modules/stockfish/bin/stockfish-19-single.*",
      "!node_modules/stockfish/bin/stockfish-19-lite-single.*",
      "!node_modules/stockfish/bin/stockfish-19-asm.js"
    ],
    "mac": {
      "target": "dir",
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png"
    },
    "asarUnpack": [
      "node_modules/stockfish/bin/**"
    ]
  }
}
