{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    // Node only: the headless core must build without Electron, Vite or DOM types.
    "types": ["node"]
  },
  "include": ["src/core/**/*.ts", "src/shared/**/*.ts"]
}
