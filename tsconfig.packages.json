{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@kchess/native": ["./crates/kchess-node/js/index.ts"],
      "@kchess/native/*": ["./crates/kchess-node/js/*"],
      "@kchess/rules/*": ["./crates/kchess-wasm/js/*"],
      "@kchess/contracts/*": ["./crates/kchess-contracts/ts/*"],
      "@kchess/node": ["./hosts/node/src/index.ts"]
    }
  }
}
