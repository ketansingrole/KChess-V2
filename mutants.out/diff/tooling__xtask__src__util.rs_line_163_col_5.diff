 pub fn sha256_file(path: &Path) -> Result<String> {
     use sha2::Digest;
     let bytes =
         std::fs::read(path).map_err(|cause| format!("Cannot read {}: {cause}", path.display()))?;
     Ok(hex(&sha2::Sha256::digest(&bytes)))
 }
