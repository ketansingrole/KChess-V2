{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "electron-vite/node"],
    "paths": {
      "@kchess/native": ["../../crates/kchess-node/js/index.ts"],
      "@kchess/native/*": ["../../crates/kchess-node/js/*"],
      "@kchess/rules/*": ["../../crates/kchess-wasm/js/*"],
      "@kchess/contracts/*": ["../../crates/kchess-contracts/ts/*"]
    }
  },
  "include": ["electron/**/*.ts", "contracts/**/*.ts", "electron.vite.config.ts"]
}
